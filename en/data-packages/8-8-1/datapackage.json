{
  "resources": [
    {
      "path": "data.csv",
      "name": "data",
      "profile": "tabular-data-resource",
      "scheme": "file",
      "format": "csv",
      "hashing": "md5",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "Year",
            "type": "integer",
            "title": "Year"
          },
          {
            "name": "outcome",
            "type": "string",
            "constraints": {
              "enum": [
                "Non-fatal",
                "Fatal",
                ""
              ]
            },
            "title": "Outcome"
          },
          {
            "name": "Units",
            "type": "string",
            "constraints": {
              "enum": [
                "In number",
                ""
              ]
            },
            "title": "unit"
          },
          {
            "name": "Series",
            "type": "string",
            "constraints": {
              "enum": [
                "Persons",
                "pr. 100,000 employee",
                ""
              ]
            },
            "title": "measure"
          },
          {
            "name": "sex",
            "type": "string",
            "constraints": {
              "enum": [
                "Total",
                "Males",
                "Females",
                ""
              ]
            },
            "title": "Sex"
          },
          {
            "name": "Value",
            "type": "number",
            "title": "Value"
          }
        ]
      }
    }
  ],
  "profile": "data-package",
  "name": "8-8-1",
  "title": "Fatal and non-fatal occupational injuries per 100,000 workers, by sex and migrant status"
}